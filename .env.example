VITE_API_URL=http://localhost:8000
PACKETPILOT_DATABASE_URL=sqlite:///./packetpilot.db
PACKETPILOT_CAPTURE_DIR=./data/captures
# Standard Windows install detected on this machine:
PACKETPILOT_TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe
PACKETPILOT_DUMPCAP_PATH=C:\Program Files\Wireshark\dumpcap.exe
PACKETPILOT_MAX_CAPTURE_MB=2048
PACKETPILOT_RETENTION_DAYS=30
OPENAI_API_KEY=test
PACKETPILOT_MODEL=gpt-5-mini

# Optional. Leave blank until geographic views are enabled.
PACKETPILOT_GEOIP_DATABASE=
